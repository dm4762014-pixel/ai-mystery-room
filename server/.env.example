NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# Choose gemini for the submission guide, or ollama for local inference.
GENERATION_PROVIDER=gemini
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3

# Enable Gemini calls deliberately; tests use mocks.
GEMINI_API_KEY=replace-me
AI_GENERATION_ENABLED=false

# Public-generation limits (UTC calendar day)
MAX_GENERATIONS_PER_GUEST_PER_DAY=3
MAX_GENERATIONS_PER_DAY=30
# Set this to the exact public frontend URL on deployment.
# The frontend proxies /api to the backend to keep cookies same-origin.
