{
  "name": "@mystery/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "prettier --check src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration.test.ts",
    "seed:demo": "tsx src/seed.ts",
    "start": "node --import tsx src/server.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@mystery/shared": "workspace:*",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.3",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "mongodb-memory-server": "^10.2.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
