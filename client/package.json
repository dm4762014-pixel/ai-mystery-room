{
  "name": "ai-mystery-room-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "prettier --check src api index.html vite.config.ts playwright.config.ts e2e vercel.json",
